<?xml version="1.0"?>
<mamelayout version="2">

  <!-- JX-3P temporary panel and LED matrix diagnostic layout. -->
  <!-- Output names match: m_ledline, m_ledscline and m_led. -->

  <element name="panel_bg">
    <rect><color red="0.035" green="0.040" blue="0.045" /></rect>
  </element>

  <element name="section_bg">
    <rect><color red="0.065" green="0.070" blue="0.075" /></rect>
  </element>

  <element name="button">
    <rect state="0"><color red="0.32" green="0.34" blue="0.36" /></rect>
    <rect state="1"><color red="0.62" green="0.66" blue="0.70" /></rect>
  </element>

  <element name="panel_led">
    <disk state="0"><color red="0.18" green="0.015" blue="0.010" /></disk>
    <disk state="1"><color red="1.00" green="0.10" blue="0.025" /></disk>
  </element>

  <element name="matrix_led">
    <rect><color red="0.12" green="0.01" blue="0.01" /></rect>
    <disk state="0">
      <bounds x="0.20" y="0.20" width="0.60" height="0.60" />
      <color red="0.20" green="0.01" blue="0.01" />
    </disk>
    <disk state="1">
      <bounds x="0.20" y="0.20" width="0.60" height="0.60" />
      <color red="1.00" green="0.08" blue="0.02" />
    </disk>
  </element>

  <element name="bus_led">
    <rect><color red="0.08" green="0.08" blue="0.08" /></rect>
    <disk state="0">
      <bounds x="0.20" y="0.20" width="0.60" height="0.60" />
      <color red="0.10" green="0.10" blue="0.10" />
    </disk>
    <disk state="1">
      <bounds x="0.20" y="0.20" width="0.60" height="0.60" />
      <color red="0.10" green="1.00" blue="0.15" />
    </disk>
  </element>

  <element name="title_text">
    <text string="JX-3P TEMPORARY PANEL AND LED MATRIX MONITOR">
      <color red="0.92" green="0.92" blue="0.92" />
    </text>
  </element>
  <element name="matrix_title">
    <text string="LATCHED 4 x 8 LED MATRIX">
