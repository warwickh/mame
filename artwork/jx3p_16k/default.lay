<!-- ====================================================== -->
<!-- 16-CHANNEL DAC BARGRAPH                                -->
<!-- ====================================================== -->

<element name="dac_bar">
    <rect>
        <color red="0.03" green="0.03" blue="0.03" />
    </rect>

    <rect state="1">
        <bounds x="0.15" y="0.00" width="0.70" height="1.00" />
        <color red="0.00" green="1.00" blue="0.15" />
    </rect>
</element>

<element name="dac_title">
    <text string="DAC OUTPUTS">
        <color red="1.0" green="1.0" blue="1.0" />
    </text>
</element>

<element name="dac0_label">
    <text string="0">
        <color red="0.90" green="0.90" blue="0.90" />
    </text>
</element>

<element name="dac1_label">
    <text string="1">
        <color red="0.90" green="0.90" blue="0.90" />
    </text>
</element>

<!-- continue labels to dac15_label -->
<element name="slider_low_label">
    <text string="LOW">
        <color red="0.95" green="0.95" blue="0.95" />
    </text>
</element>

<element name="slider_mid_label">
    <text string="MID">
        <color red="0.95" green="0.95" blue="0.95" />
    </text>
</element>

<element name="slider_high_label">
    <text string="HIGH">
        <color red="0.95" green="0.95" blue="0.95" />
    </text>
</element>


